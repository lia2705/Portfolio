CSS


/* --- PICTURE GRID --- */

*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
}

.esn-section {
    width: 100%;
    padding: 0 5vw;
    margin-bottom: 5vw;
}

.esn-grid {
    display: grid;
    grid-template-columns: 310fr 253fr 132fr 90fr 193fr 120fr;
    grid-template-rows: 19.5vw 22vw 30vw;
    gap: 3px;
    width: 100%;
}

.cell {
    overflow: hidden;
    background: #1a1a1a;
    position: relative;
    min-width: 0;
    min-height: 0;
    cursor: pointer;
    transition: filter 0.35s ease;
    z-index: 1;
}

.cell img,
.cell video {
    width: 100%;
    height: 100%;
    object-fit: fill;
    object-position: center center;
    display: block;
    margin-bottom: 0;
    border-radius: 0;
    transition: all 0.35s ease;
}

/* Placement */
.cell-1  { grid-column: 1;     grid-row: 1 / 3; }
.cell-2  { grid-column: 2;     grid-row: 1;     }
.cell-3  { grid-column: 4 / 7; grid-row: 1;     }

.cell-4  { grid-column: 2;     grid-row: 2;     }
.cell-5  { grid-column: 3;     grid-row: 1;     }
.cell-6  { grid-column: 3 / 5; grid-row: 2; }  /* 1 Spalte  → kleiner */
.cell-7  { grid-column: 5 / 7; grid-row: 2; }  /* 2 Spalten → breiter */

.cell-8  { grid-column: 1;     grid-row: 3;     }
.cell-9  { grid-column: 2;     grid-row: 3;     }
.cell-10 { grid-column: 3 / 5; grid-row: 3;     }
.cell-11 { grid-column: 5 / 7; grid-row: 3;     }

